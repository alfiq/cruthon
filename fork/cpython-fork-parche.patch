+# Blob declarations
+# ------------------
+#
+# A 'blob' declares a set with its own memory.  Its body is a scope of its
+# own: the names defined there live in the blob's namespace, and the functions
+# defined inside it always see that namespace (never the caller's).
+#
+# 'blob NAME = a & b:' derives the new blob from an operation between sets.
+
+blob_stmt[stmt_ty]:
+    | 'blob' n=NAME s=['=' e=expression { e }] ':' b=block {
+        _PyAST_Blob(n->v.Name.id, s, b, EXTRA) }
+
 # Function definitions
 # --------------------
 
